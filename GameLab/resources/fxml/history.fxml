<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.fx.controllers.HistoryController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <Label styleClass="title" text="Game History">
            <font>
               <Font name="System Bold" size="20.0" />
            </font>
         </Label>
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh" />
            <Button fx:id="backButton" onAction="#handleBack" styleClass="back-button" text="Back to Menu" />
         </HBox>
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <TableView fx:id="historyTable" prefHeight="350.0">
            <columns>
               <TableColumn fx:id="gameIdColumn" prefWidth="60.0" text="Game ID" />
               <TableColumn fx:id="roomIdColumn" prefWidth="80.0" text="Room ID" />
               <TableColumn fx:id="playersColumn" prefWidth="200.0" text="Players" />
               <TableColumn fx:id="winnerColumn" prefWidth="100.0" text="Winner" />
               <TableColumn fx:id="durationColumn" prefWidth="80.0" text="Duration" />
               <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
            </columns>
         </TableView>
      </VBox>
   </center>
   <bottom>
      <Label fx:id="statusLabel" text="Loading history..." BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </Label>
   </bottom>
</BorderPane>