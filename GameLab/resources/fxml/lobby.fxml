<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.fx.controllers.LobbyController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <Label styleClass="title" text="Game Lobby">
            <font>
               <Font name="System Bold" size="20.0" />
            </font>
         </Label>
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <TextField fx:id="roomIdField" promptText="Enter Room ID" />
            <Button fx:id="joinSpecificRoomButton" onAction="#handleJoinSpecificRoom" text="Join Room" />
            <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh" />
            <Button fx:id="backButton" onAction="#handleBack" styleClass="back-button" text="Back to Menu" />
         </HBox>
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <Label text="Available Rooms:">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>
         <ListView fx:id="roomListView" prefHeight="400.0" />
      </VBox>
   </center>
   <bottom>
      <Label fx:id="statusLabel" text="Loading rooms..." BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </Label>
   </bottom>
</BorderPane>